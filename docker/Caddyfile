# HTTPS in front of the service. Caddy gets and renews a Let's Encrypt certificate for $SITE_DOMAIN by itself.
# WhatsApp webhooks need HTTPS, so production always runs behind this.
{$SITE_DOMAIN} {
	encode gzip
	reverse_proxy app:8000
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
