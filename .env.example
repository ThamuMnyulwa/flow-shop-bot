# Copy to .env for local development. Every setting can also come from the environment (E4).
FLOWSHOP_ENV=local
FLOWSHOP_DATABASE_URL=postgresql+psycopg://flowshop:flowshop@localhost:5432/flowshop
FLOWSHOP_SECRET_KEY=change-me-to-a-long-random-string
FLOWSHOP_BASE_URL=http://localhost:8000
FLOWSHOP_CHANNEL=simulator
FLOWSHOP_ALLOW_TIME_TRAVEL=true
FLOWSHOP_JOBS_TOKEN=dev-jobs-token
FLOWSHOP_CORS_ORIGINS=http://localhost:8888
FLOWSHOP_WA_BUSINESS_NUMBER=27000000000

# Go-live only (phase 3)
# FLOWSHOP_CHANNEL=whatsapp
# FLOWSHOP_WA_PHONE_ID=
# FLOWSHOP_WA_TOKEN=
# FLOWSHOP_WA_APP_SECRET=
# FLOWSHOP_WA_VERIFY_TOKEN=

# Optional staff alert email
# FLOWSHOP_SMTP_HOST=
# FLOWSHOP_SMTP_USER=
# FLOWSHOP_SMTP_PASSWORD=
# FLOWSHOP_ALERT_EMAIL_FROM=
# FLOWSHOP_ALERT_EMAIL_TO=

# AI assistant (phase 5), off by default
# FLOWSHOP_AI_ENABLED=true
# FLOWSHOP_ANTHROPIC_API_KEY=
