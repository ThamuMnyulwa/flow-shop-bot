# Copy to terraform.tfvars (git-ignored).
project_id               = "floww-shop"
cors_origins             = "https://floww.netlify.app"
base_url                 = ""     # e.g. "https://shop-api.floww.co.za" once a custom domain is mapped
min_instances            = 0      # 1 = no slow first reply, about $10-14 a month
database_history_seconds = 21600  # raise to 604800 (7 days) on Neon's Launch plan
whatsapp_live            = false  # true at go-live
wa_business_number       = "27000000000"

# Secrets, stored in Secret Manager. terraform.tfvars is never committed.
secrets = {
  # FLOWSHOP_WA_PHONE_ID     = ""
  # FLOWSHOP_WA_TOKEN        = ""
  # FLOWSHOP_WA_APP_SECRET   = ""
  # FLOWSHOP_WA_VERIFY_TOKEN = ""
  # FLOWSHOP_SENTRY_DSN      = ""
}
