# Production settings for docker-compose.prod.yml. Copy to .env.prod (never commit it) and fill in every value.
# Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"

# The domain pointing at this server, without https://. Caddy gets its certificate for this name.
SITE_DOMAIN=shop-api.example.co.za

POSTGRES_PASSWORD=
FLOWSHOP_SECRET_KEY=
FLOWSHOP_JOBS_TOKEN=

# Used once, by `flowshop seed --no-orders`, to create the first admin account (12+ characters).
FLOWSHOP_ADMIN_PASSWORD=

# The Netlify site, so it can read live stock.
FLOWSHOP_CORS_ORIGINS=https://floww.netlify.app

# WhatsApp: keep "simulator" until go-live (docs/go-live-whatsapp.md).
FLOWSHOP_CHANNEL=simulator
FLOWSHOP_WA_BUSINESS_NUMBER=
FLOWSHOP_WA_PHONE_ID=
FLOWSHOP_WA_TOKEN=
FLOWSHOP_WA_APP_SECRET=
FLOWSHOP_WA_VERIFY_TOKEN=

# Optional: error alerts and staff alert emails.
FLOWSHOP_SENTRY_DSN=
FLOWSHOP_SMTP_HOST=
FLOWSHOP_SMTP_USER=
FLOWSHOP_SMTP_PASSWORD=
FLOWSHOP_ALERT_EMAIL_FROM=
FLOWSHOP_ALERT_EMAIL_TO=
